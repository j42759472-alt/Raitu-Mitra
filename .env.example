# --- Build-time (Vite inlines into the JS bundle) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Leave empty for same-origin /api (default). Set only for cross-origin API host.
VITE_API_BASE=

# --- Runtime (Express server — set on Railway, not needed for `npm run dev` unless running the server) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Optional; used if client sends anon JWT for payment routes
SUPABASE_ANON_KEY=your-anon-key-here
GROQ_API_KEY=your-groq-api-key
CASHFREE_APP_ID=TEST100xxxxxxxxxx
CASHFREE_SECRET_KEY=your-cashfree-secret
CASHFREE_ENV=sandbox
# Optional. Cashfree webhook target for wallet credit if checkout closes early.
# CASHFREE_NOTIFY_URL=https://your-domain/api/verify-payment
